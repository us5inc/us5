---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
  sections?: readonly { id: string; label: string }[];
}
const { title, description, path, updated, sections } = Astro.props;
---

<BaseLayout {title} {description} {path}
  ><PageHero eyebrow="Legal & support" {title} intro={`Last updated ${updated}`} /><div
    class="legal-grid shell"
  >
    {
      sections?.length ? (
        <aside class="legal-rail">
          <nav aria-label="On this page">
            <ol>
              {sections.map(({ id, label }) => (
                <li>
                  <a href={`#${id}`}>{label}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      ) : null
    }
    <article class="prose">
      <slot />
    </article>
  </div></BaseLayout
>
