---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
---

<BaseLayout {title} {description} {path}
  ><PageHero eyebrow="Legal & support" {title} intro={`Last updated ${updated}`} /><article
    class="prose shell"
  >
    <slot />
  </article></BaseLayout
>
