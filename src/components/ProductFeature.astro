---
import { publishedProducts } from '../config/featured-product';
import { withBase } from '../lib/urls';
---

<section class="product-feature-band" aria-label="Published mobile games">
  <div class="shell">
    {
      publishedProducts.map((product) => (
        <article class="product-feature">
          <img
            src={withBase(product.icon)}
            alt={`${product.name} game icon`}
            width="512"
            height="512"
          />
          <div class="product-feature-copy">
            <span class="eyebrow">{product.status}</span>
            <h2 id={`published-product-${product.slug}`}>
              <a href={withBase(product.productPath)}>{product.name}</a>
            </h2>
            <p>{product.summary}</p>
            <div class="product-feature-actions">
              <a class="button compact" href={withBase(product.productPath)}>
                View product
              </a>
              <a href={withBase(product.privacyPath)}>Privacy</a>
              <a href={withBase(product.supportPath)}>Support</a>
              <a href={withBase(product.deletionPath)}>Data deletion</a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
