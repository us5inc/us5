---
import EmailLink from './EmailLink.astro';
import Logo from './Logo.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/urls';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-intro">
      <Logo />
      <p class="footer-statement">
        Mobile experiences and practical digital products, built with care.
      </p>
    </div>
    <div class="footer-column">
      <h2>
        <span aria-hidden="true">01 /</span>
        Explore
      </h2>
      <a href={withBase('/digital-solutions/')}>Digital solutions</a>
      <a href={withBase('/about/')}>About US5</a>
      <a href={withBase('/contact/')}>Contact</a>
    </div>
    <div class="footer-column">
      <h2>
        <span aria-hidden="true">02 /</span>
        Company
      </h2>
      <a href={withBase('/support/')}>Support</a>
      <a href={withBase('/privacy/')}>Privacy</a>
      <a href={withBase('/terms/')}>Terms</a>
      <a href={withBase('/data-deletion/')}>Data deletion</a>
    </div>
    <div class="footer-column footer-contact">
      <h2>
        <span aria-hidden="true">03 /</span>
        Contact
      </h2>
      <EmailLink email={siteConfig.email}>{siteConfig.email}</EmailLink>
    </div>
  </div>
  <div class="shell copyright">
    <span>© {new Date().getFullYear()} US5 Incorporation. All rights reserved.</span>
  </div>
</footer>
