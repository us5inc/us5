---
import { buildGmailComposeUrl } from '../lib/email';

interface Props {
  email: string;
  subject?: string;
  body?: string;
}

const { email, subject, body } = Astro.props;
const href = buildGmailComposeUrl({
  to: email,
  ...(subject === undefined ? {} : { subject }),
  ...(body === undefined ? {} : { body }),
});
---

<a href={href} target="_blank" rel="noopener noreferrer"><slot /></a>
