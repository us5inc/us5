<form id="enquiry" aria-describedby="contact-process contact-privacy" novalidate>
  <div id="form-status" class="form-note" aria-live="polite"></div><div class="field">
    <label for="name">Name</label><input
      id="name"
      name="name"
      autocomplete="name"
      aria-describedby="name-error"
      required
    /><small id="name-error" data-error="name"></small>
  </div><div class="field">
    <label for="email">Email</label><input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      aria-describedby="email-error"
      required
    /><small id="email-error" data-error="email"></small>
  </div><div class="field">
    <label for="company">Company <span class="form-note">(optional)</span></label><input
      id="company"
      name="company"
      autocomplete="organization"
    />
  </div><div class="field">
    <label for="service">Service required</label><select
      id="service"
      name="service"
      aria-describedby="service-error"
      required
      ><option value="">Select a service</option><option>Mobile game development</option><option
        >Mobile application</option
      ><option>UI/UX design</option><option>Digital solution</option><option
        >Product modernization</option
      ><option>Quality and performance</option><option>Maintenance and support</option></select
    ><small id="service-error" data-error="service"></small>
  </div><div class="field">
    <label for="summary">Project summary</label><textarea
      id="summary"
      name="summary"
      minlength="20"
      maxlength="3000"
      aria-describedby="summary-error"
      required></textarea><small id="summary-error" data-error="summary"></small>
  </div><label class="check"
    ><input
      id="consent"
      name="consent"
      type="checkbox"
      aria-describedby="consent-error"
      required
    /><span>I agree that US5 Incorporation may use these details to respond to my enquiry.</span
    ></label
  ><small id="consent-error" data-error="consent"></small><button class="button" type="submit"
    >Prepare email enquiry</button
  >
</form>
<script>
  import { buildEnquiryComposeUrl, validateEnquiry } from '../lib/enquiry';
  const form = document.querySelector<HTMLFormElement>('#enquiry');
  const status = document.querySelector<HTMLElement>('#form-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const errors = validateEnquiry(data);
    form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
      const key = el.dataset.error ?? '';
      el.textContent = errors[key] ?? '';
    });
    const controls = [
      ...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input, select, textarea',
      ),
    ];
    controls.forEach((control) =>
      control.setAttribute('aria-invalid', String(Boolean(errors[control.name]))),
    );
    const firstInvalid = controls.find((control) => Boolean(errors[control.name]));
    if (Object.keys(errors).length) {
      if (status) status.textContent = 'Please correct the highlighted fields.';
      firstInvalid?.focus();
      return;
    }
    const get = (key: string) => String(data.get(key) ?? '').trim();
    if (status) status.textContent = 'Opening Gmail in a new tab.';
    window.open(
      buildEnquiryComposeUrl({
        name: get('name'),
        email: get('email'),
        company: get('company'),
        service: get('service'),
        summary: get('summary'),
      }),
      '_blank',
      'noopener,noreferrer',
    );
  });
</script>
