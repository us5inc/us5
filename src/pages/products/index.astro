---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import { publishedProducts } from '../../config/featured-product';
import { withBase } from '../../lib/urls';
---

<BaseLayout
  title="Products"
  description="Published mobile products from US5 Incorporation."
  path="/products/"
  ><PageHero
    eyebrow="Products"
    title="Published mobile experiences."
    intro="Explore product information and direct support resources from US5 Incorporation."
  /><section class="section alt">
    <div class="shell product-list">
      {
        publishedProducts.map((product) => (
          <article class="product-card">
            <img
              src={withBase(product.icon)}
              alt={`${product.name} game icon`}
              width="512"
              height="512"
            />
            <div class="product-copy">
              <span class="eyebrow">{product.status}</span>
              <h2>
                <a href={withBase(product.productPath)}>{product.name}</a>
              </h2>
              <p>{product.summary}</p>
              <dl>
                <div>
                  <dt>Developer</dt>
                  <dd>{product.developer}</dd>
                </div>
                <div>
                  <dt>Category</dt>
                  <dd>{product.category}</dd>
                </div>
              </dl>
              <nav class="product-links" aria-label={`${product.name} resources`}>
                <a href={withBase(product.productPath)}>View product</a>
                <a
                  href={product.playUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={'View ' + product.name + ' on Google Play'}
                >
                  View on Google Play
                </a>
                <a href={withBase(product.privacyPath)}>Privacy</a>
                <a href={withBase(product.supportPath)}>Support</a>
                <a href={withBase(product.deletionPath)}>Data deletion</a>
              </nav>
            </div>
          </article>
        ))
      }
    </div>
  </section><Cta /></BaseLayout
>

<style>
  .product-list {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .product-card {
    display: grid;
    grid-template-columns: minmax(12rem, 24rem) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid var(--line-dark);
    border-radius: 10px;
    background: var(--white);
  }
  .product-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18%;
    box-shadow: 0 24px 60px rgb(10 14 26 / 18%);
  }
  .product-copy h2 {
    margin: 0.75rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .product-copy > p {
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2rem 0;
  }
  dl div {
    min-width: 9rem;
  }
  dt {
    font-family: var(--font-mono);
    color: var(--ink-faint);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  dd {
    margin: 0.25rem 0 0;
    font-weight: 600;
  }
  .product-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-dark);
  }
  .product-links a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 760px) {
    .product-card {
      grid-template-columns: 1fr;
    }
    .product-card img {
      max-width: 18rem;
    }
  }
</style>
