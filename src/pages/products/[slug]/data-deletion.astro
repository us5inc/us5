---
import EmailLink from '../../../components/EmailLink.astro';
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { products } from '../../../config/products';
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const productDeletionSections = [{ id: 'request-deletion', label: 'Request deletion' }] as const;
---

<LegalLayout
  title={`${product.name} data deletion`}
  description={`Data deletion instructions for ${product.name}.`}
  path={`/products/${product.slug}/data-deletion/`}
  updated={product.updatedDate}
  sections={productDeletionSections}
  ><h2 id="request-deletion">Request deletion</h2><p>{product.deletion}</p><p>
    Contact <EmailLink email={product.supportEmail}>{product.supportEmail}</EmailLink> and identify the
    product and relevant account or device context without sending passwords.
  </p></LegalLayout
>
