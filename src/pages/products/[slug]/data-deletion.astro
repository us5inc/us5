---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { products } from '../../../config/products';
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
---

<LegalLayout
  title={`${product.name} data deletion`}
  description={`Data deletion instructions for ${product.name}.`}
  path={`/products/${product.slug}/data-deletion/`}
  updated={product.updatedDate}
  ><h2>Request deletion</h2><p>{product.deletion}</p><p>
    Contact <a href={`mailto:${product.supportEmail}`}>{product.supportEmail}</a> and identify the product
    and relevant account or device context without sending passwords.
  </p></LegalLayout
>
