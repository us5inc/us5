---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CapabilityLedger from '../components/CapabilityLedger.astro';
import ProcessRail from '../components/ProcessRail.astro';
import TechnicalSection from '../components/TechnicalSection.astro';
import Cta from '../components/Cta.astro';
import { services } from '../config/services';
---

<BaseLayout
  title="Services"
  description="Mobile game development, application development, design, modernization, quality, and support from US5 Incorporation."
  path="/services/"
  ><PageHero
    eyebrow="Services"
    title="Capabilities shaped around outcomes."
    intro="Choose focused support for one product stage or connect the full journey from concept through ongoing improvement."
  /><section
    class="section services-ledger"
    data-page-system="capability-ledger"
    aria-labelledby="service-capabilities-title"
  >
    <div class="shell">
      <header class="section-head">
        <h2 id="service-capabilities-title">Capabilities</h2>
      </header>
      <CapabilityLedger items={services} />
    </div>
  </section><TechnicalSection
    figure="01"
    label="How we work"
    title="Clarity at every stage."
    intro="We connect product intent, interface design, engineering, testing, and delivery so each decision supports the experience as a whole."
    tone="dark"
  >
    <ProcessRail />
  </TechnicalSection><Cta /></BaseLayout
>
