---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Contact"
  description="Discuss a mobile game, application, or digital product with US5 Incorporation."
  path="/contact/"
  ><PageHero
    eyebrow="Start a conversation"
    title="Tell us what you want to move forward."
    intro="Share the goal, the audience, and where your product stands today. Your email application will prepare the message for you."
  /><section class="section contact-section">
    <div class="shell contact-layout">
      <aside class="contact-brief" aria-label="Contact briefing">
        <p>
          Prefer to write directly? Email <a href={`mailto:${siteConfig.email}`}
            >{siteConfig.email}</a
          >.
        </p>
        <p id="contact-process">Your email application will open with a prepared message.</p>
        <p id="contact-privacy">Nothing is stored by this website.</p>
      </aside><div class="contact-form-panel"><EnquiryForm /></div>
    </div>
  </section></BaseLayout
>
