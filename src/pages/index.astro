---
import BaseLayout from '../layouts/BaseLayout.astro';
import CapabilityLedger from '../components/CapabilityLedger.astro';
import Cta from '../components/Cta.astro';
import HeroMark from '../components/HeroMark.astro';
import ProcessRail from '../components/ProcessRail.astro';
import ProductFeature from '../components/ProductFeature.astro';
import TechnicalSection from '../components/TechnicalSection.astro';
import { services } from '../config/services';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Mobile games and digital solutions"
  description="US5 Incorporation creates engaging mobile experiences and practical digital solutions."
  path="/"
  ><section class="hero">
    <div class="shell hero-grid">
      <div>
        <span class="eyebrow">Mobile products, thoughtfully made</span><h1>
          Games that entertain.<br /><span class="gradient">Digital solutions that perform.</span>
        </h1><p class="lead">
          US5 Incorporation designs and develops mobile experiences that balance engaging
          interaction with dependable product thinking.
        </p><div class="actions">
          <a class="button" href={withBase('/products/')}>Explore our games</a><a
            class="button secondary"
            href={withBase('/contact/')}>Discuss a project</a
          >
        </div>
      </div><HeroMark />
    </div>
  </section><ProductFeature /><TechnicalSection
    figure="01"
    label="What we build"
    title="From first interaction to lasting utility."
    intro="Focused delivery for entertainment products and the digital systems that help organizations move forward."
  >
    <CapabilityLedger items={services.slice(0, 6)} />
  </TechnicalSection><TechnicalSection
    figure="02"
    label="How we work"
    title="Clarity at every stage."
    intro="We connect product intent, interface design, engineering, testing, and delivery so each decision supports the experience as a whole."
    tone="dark"
  >
    <ProcessRail />
  </TechnicalSection><Cta /></BaseLayout
>
