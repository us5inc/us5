---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="Page not found" description="The requested page could not be found." path="/404/"
  ><section class="page-hero shell">
    <span class="eyebrow">404</span><h1>This route has drifted off course.</h1><p>
      The page may have moved, or the address may be incomplete.
    </p><div class="actions">
      <a class="button" href={withBase('/')}>Return home</a><a
        class="button secondary"
        href={withBase('/contact/')}>Contact US5</a
      >
    </div>
  </section></BaseLayout
>
