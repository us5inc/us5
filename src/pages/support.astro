---
import LegalLayout from '../layouts/LegalLayout.astro';
import { featuredProduct } from '../config/featured-product';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/urls';
const supportSections = [
  { id: 'how-we-can-help', label: 'How we can help' },
  { id: 'what-to-include', label: 'What to include' },
  { id: 'product-support', label: 'Product support' },
  { id: 'privacy-support', label: 'Privacy support' },
] as const;
---

<LegalLayout
  title="Support"
  description="Contact US5 Incorporation for website, product, and privacy support."
  path="/support/"
  updated="29 August 2026"
  sections={supportSections}
  ><h2 id="how-we-can-help">How we can help</h2><p>
    For support with <strong>{featuredProduct.name}</strong>, website questions, business enquiries,
    or privacy requests, email <a href={'mailto:' + siteConfig.email}>{siteConfig.email}</a>.
  </p><h2 id="what-to-include">What to include</h2><p>
    Name the product or page involved, describe what you expected, and explain what happened. For
    privacy requests, include enough information for us to identify the relevant correspondence or
    product context, but do not send passwords or sensitive credentials.
  </p><h2 id="product-support">Product support</h2><p>
    When contacting us about {featuredProduct.name}, include the device context and a concise
    description of the issue. This verified email channel is the direct support route published by
    US5 Incorporation.
  </p><h2 id="privacy-support">Privacy support</h2><p>
    Read the <a href={withBase(featuredProduct.privacyPath)}>privacy policy</a> for the game's current
    disclosures, or email us with a specific question.
  </p></LegalLayout
>
