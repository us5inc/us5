---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
const items = [
  [
    'Custom mobile applications',
    'Give customers or teams a focused mobile experience shaped around a real workflow.',
  ],
  [
    'Business workflow solutions',
    'Reduce repetitive handoffs and bring important work into a clearer, more consistent flow.',
  ],
  [
    'API integrations',
    'Help products and services exchange information reliably across established boundaries.',
  ],
  [
    'Cloud-connected systems',
    'Connect applications to well-structured services that can support secure, dependable product experiences.',
  ],
  [
    'Product consulting & modernization',
    'Clarify the next practical move for an existing product, from experience improvements to technical renewal.',
  ],
];
---

<BaseLayout
  title="Digital solutions"
  description="Practical mobile applications, workflows, integrations, and product modernization from US5 Incorporation."
  path="/digital-solutions/"
  ><PageHero
    eyebrow="Beyond games"
    title="Digital products that make work flow better."
    intro="We apply the same care for interaction and performance to practical software for organizations and their customers."
  /><section
    class="system-bands-section"
    data-page-system="system-bands"
    aria-label="Digital solutions"
  >
    <ol class="system-bands">
      {
        items.map(([title, body], i) => (
          <li class="system-band">
            <div class="shell system-band-grid">
              <div class="system-band-index" aria-hidden="true">
                <span class="technical-index">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="system-band-copy">
                <h2>{title}</h2>
                <p>{body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section><Cta /></BaseLayout
>
